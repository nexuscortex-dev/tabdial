{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "Tabdial",
  "version": "0.5.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage", "unlimitedStorage", "favicon", "activeTab", "alarms", "search", "fontSettings"],
  "optional_permissions": ["topSites", "identity", "history", "bookmarks"],
  "omnibox": { "keyword": "z" },
  "externally_connectable": { "matches": ["https://nexuscortex.dev/tabdial/join/*"] },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "__MSG_actionTitle__", "default_popup": "popup.html" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "browser_specific_settings": {
    "gecko": { "id": "tabdial@nexuscortex.dev", "strict_min_version": "140.0", "data_collection_permissions": { "required": ["none"], "optional": ["authenticationInfo", "browsingActivity", "personallyIdentifyingInfo", "bookmarksInfo", "websiteContent"] } }
  }
}
